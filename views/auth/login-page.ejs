<%- include('../partials/head') %>
<body class="min-h-screen bg-slate-50 text-slate-900">
    <%- include('../partials/navbar') %>
    <% const loginPhoto = 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=1200&q=80'; %>
    <main class="mx-auto grid min-h-[calc(100vh-73px)] max-w-6xl items-center gap-6 px-6 py-12 lg:grid-cols-[1.4fr_0.8fr]">
        <section class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
            <img src="<%= loginPhoto %>" alt="Modern home ready for booking" class="h-80 w-full object-cover">
            <div class="p-6">
                <p class="text-sm font-semibold uppercase text-rose-600">Welcome</p>
                <h1 class="mt-2 text-3xl font-bold text-slate-950 sm:text-4xl">Continue your stay planning</h1>
                <p class="mt-2 max-w-2xl text-sm text-slate-600">Sign in to manage reservations, save favourite homes, and keep your hosting details up to date.</p>
            </div>
        </section>

        <section class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <div class="border-b border-slate-200 pb-6">
                <p class="text-sm font-semibold uppercase text-rose-600">Account access</p>
                <h2 class="mt-2 text-3xl font-bold text-slate-950">Login</h2>
                <p class="mt-2 text-sm text-slate-600">Use your account details to get back to AirBnB.</p>
            </div>

            <form action="/login" method="POST" class="mt-6 space-y-5">
                <div>
                    <label for="email" class="mb-2 block text-sm font-medium text-slate-700">Email address</label>
                    <input id="email" type="email" name="email" placeholder="you@example.com" autocomplete="email" required class="w-full rounded-md border border-slate-300 px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-rose-500 focus:ring-4 focus:ring-rose-100">
                </div>

                <div>
                    <label for="password" class="mb-2 block text-sm font-medium text-slate-700">Password</label>
                    <input id="password" type="password" name="password" placeholder="Enter your password" autocomplete="current-password" required class="w-full rounded-md border border-slate-300 px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-rose-500 focus:ring-4 focus:ring-rose-100">
                </div>

                <div class="flex items-center justify-between gap-4 text-sm">
                    <label for="remember" class="flex items-center gap-3 font-medium text-slate-700">
                        <input id="remember" type="checkbox" name="remember">
                        Remember me
                    </label>
                    <a href="#" class="font-semibold text-rose-600 transition hover:text-rose-700">Forgot password?</a>
                </div>

                <button type="submit" class="w-full rounded-md bg-rose-600 px-5 py-3 font-semibold text-white transition hover:bg-rose-700 focus:outline-none focus:ring-4 focus:ring-rose-200 cursor-pointer">Login</button>
            </form>

            <p class="mt-6 rounded-md bg-rose-50 p-4 text-sm text-rose-700">New here? Browse homes from the homepage or register your property from the host tools.</p>
        </section>
    </main>
</body>
</html>

