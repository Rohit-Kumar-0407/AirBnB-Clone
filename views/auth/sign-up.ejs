<%- include('../partials/head') %>
<body class="min-h-screen bg-slate-50 text-slate-900">
    <%- include('../partials/navbar') %>
    <% const signupPhoto = 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80'; %>
    <main class="mx-auto grid min-h-[calc(100vh-73px)] max-w-6xl items-center gap-6 px-6 py-12 lg:grid-cols-[1.1fr_0.9fr]">
        <section class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
            <img src="<%= signupPhoto %>" alt="Comfortable home interior" class="h-80 w-full object-cover">
            <div class="p-6">
                <p class="text-sm font-semibold uppercase text-rose-600">Create account</p>
                <h1 class="mt-2 text-3xl font-bold text-slate-950 sm:text-4xl">Start your AirBnB journey</h1>
                <p class="mt-2 max-w-2xl text-sm text-slate-600">Sign up to book stays or manage your homes.</p>
            </div>
        </section>

        <section class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <div class="border-b border-slate-200 pb-6">
                <p class="text-sm font-semibold uppercase text-rose-600">New account</p>
                <h2 class="mt-2 text-3xl font-bold text-slate-950">Sign up</h2>
                <p class="mt-2 text-sm text-slate-600">Enter your details to create an AirBnB account.</p>
            </div>

            <% if (typeof errorMessages !== 'undefined' && errorMessages.length > 0) { %>
                <div role="alert" aria-labelledby="signup-errors-title" class="mt-6 rounded-md border border-red-200 bg-red-50 p-4">
                    <p id="signup-errors-title" class="text-sm font-semibold text-red-800">Please fix the following errors:</p>
                    <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
                        <% errorMessages.forEach((message) => { %>
                            <li class="text-red-800"><%= message %></li>
                        <% }); %>
                    </ul>
                </div>
            <% } %>

            <form action="/signup" method="POST" class="mt-6 space-y-5">
                <div class="grid gap-5 sm:grid-cols-2">
                    <div>
                        <label for="firstName" class="mb-2 block text-sm font-medium text-slate-700">First name</label>
                        <input id="firstName" type="text" name="firstName" placeholder="First name" autocomplete="given-name" required class="w-full rounded-md border border-slate-300 px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-rose-500 focus:ring-4 focus:ring-rose-100" value="<%= (typeof oldInput !== 'undefined' && oldInput) ? oldInput.firstName : '' %>">
                    </div>

                    <div>
                        <label for="lastName" class="mb-2 block text-sm font-medium text-slate-700">Last name</label>
                        <input id="lastName" type="text" name="lastName" placeholder="Last name" autocomplete="family-name" required class="w-full rounded-md border border-slate-300 px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-rose-500 focus:ring-4 focus:ring-rose-100" value="<%= (typeof oldInput !== 'undefined' && oldInput) ? oldInput.lastName : '' %>">
                    </div>
                </div>

                <div>
                    <label for="email" class="mb-2 block text-sm font-medium text-slate-700">Email address</label>
                    <input id="email" type="email" name="email" placeholder="you@example.com" autocomplete="email" required class="w-full rounded-md border border-slate-300 px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-rose-500 focus:ring-4 focus:ring-rose-100" value="<%= (typeof oldInput !== 'undefined' && oldInput) ? oldInput.email : '' %>">
                </div>

                <div class="grid gap-5 sm:grid-cols-2">
                    <div>
                        <label for="password" class="mb-2 block text-sm font-medium text-slate-700">Password</label>
                        <input id="password" type="password" name="password" placeholder="Create a password" autocomplete="new-password" required class="w-full rounded-md border border-slate-300 px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-rose-500 focus:ring-4 focus:ring-rose-100">
                    </div>

                    <div>
                        <label for="confirmPassword" class="mb-2 block text-sm font-medium text-slate-700">Confirm password</label>
                        <input id="confirmPassword" type="password" name="confirmPassword" placeholder="Confirm password" autocomplete="new-password" required class="w-full rounded-md border border-slate-300 px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-rose-500 focus:ring-4 focus:ring-rose-100">
                    </div>
                </div>
                <div>
                    <label class="mb-2 block text-sm font-medium text-slate-700">I am a</label>
                    <div class="flex gap-6">
                        <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
                            <input type="radio" name="role" value="guest" required class="accent-rose-600">
                            Guest
                        </label>
                        <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
                            <input type="radio" name="role" value="host" required class="accent-rose-600">
                            Host
                        </label>
                    </div>
                </div>

                <label for="terms" class="flex items-start gap-3 text-sm font-medium text-slate-700">
                    <input id="terms" type="checkbox" name="terms" required class="mt-1">
                    <span>I agree to the terms and conditions.</span>
                </label>

                <button type="submit" class="w-full cursor-pointer rounded-md bg-rose-600 px-5 py-3 font-semibold text-white transition hover:bg-rose-700 focus:outline-none focus:ring-4 focus:ring-rose-200">Create account</button>
            </form>
            <p class="mt-6 rounded-md bg-rose-50 p-4 text-sm text-rose-700">Already have an account? <a href="/login" class="font-semibold transition hover:text-rose-800">Login here</a>.</p>
        </section>
    </main>
</body>
</html>
